<Application x:Class="TouchMappingAgent.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TouchMappingAgent.WPF.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/EvolvedDesignUI.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:InverseBooleanConverter x:Key="InverseBool"/>
            <conv:NullToCollapsedConverter x:Key="NullToCollapsed"/>
            <conv:StepVisibilityConverter x:Key="StepVisibility"/>
            <conv:EnumToBooleanConverter x:Key="EnumToBool"/>
            <conv:BooleanToYesNoConverter x:Key="BoolToYesNo"/>
            <conv:BooleanToElevationConverter x:Key="BoolToElevation"/>
            <conv:BooleanToOkFailConverter x:Key="BoolToOkFail"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
