<Window x:Class="TouchMappingAgent.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TouchMappingAgent.WPF.Localization"
        Title="TouchMappingAgent" Height="640" Width="820" MinHeight="560" MinWidth="720"
        Icon="pack://application:,,,/TouchMappingAgent.WPF;component/Assets/touchmappingagent.ico"
        Loaded="MainWindow_OnLoaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- The icon mark, not the full artwork. The source logo is a square banner with a
                 wordmark and a feature strip; at the ~64px a window header allows, all of that
                 collapses into an unreadable smudge. The mark stays crisp, and the wordmark is
                 right beside it as real text anyway. The full artwork (assets\logo.png) appears
                 where there is actually room for it: the setup wizard's banner and the About
                 window. -->
            <Image Grid.Column="0" Source="pack://application:,,,/TouchMappingAgent.WPF;component/Assets/touchmappingagent.ico"
                   Width="56" Height="56" Margin="0,0,14,0"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="TouchMappingAgent" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="{loc:Loc Main_Subtitle}" FontSize="13" Foreground="Gray"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#FFF6E5" BorderBrush="#E0A800" BorderThickness="1"
                CornerRadius="4" Padding="10" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap" FontSize="12">
                <Run Text="{loc:Loc Main_NoticeLabel}" FontWeight="Bold"/>
                <Run Text="{loc:Loc Main_NoticeText}"/>
            </TextBlock>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="{loc:Loc Main_MonitorLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <!-- DisplayLabel, not DisplayName: both panels are called "DM7000", so the
                 name alone produces two indistinguishable entries. The label adds the
                 graphics connector and the desktop position. -->
            <ComboBox ItemsSource="{Binding Monitors}"
                      SelectedItem="{Binding SelectedMonitor}"
                      SelectedValuePath="DeviceId"
                      SelectedValue="{Binding SelectedMonitorId}"
                      DisplayMemberPath="DisplayLabel"
                      MinHeight="28"/>
            <Button Content="{loc:Loc Main_LoadMonitors}" Command="{Binding LoadMonitorsCommand}"
                    ToolTip="{loc:Loc Tip_LoadMonitors}" ToolTipService.ShowOnDisabled="True"
                    Margin="0,6,0,0" Padding="8,4" HorizontalAlignment="Left"/>
        </StackPanel>

        <WrapPanel Grid.Row="3" Margin="0,4,0,12">
            <Button Content="{loc:Loc Main_LearnScreen}"
                    Command="{Binding LearnSelectedMonitorCommand}"
                    ToolTip="{loc:Loc Tip_LearnScreen}" ToolTipService.ShowOnDisabled="True"
                    Padding="10,6" FontWeight="SemiBold"/>
        </WrapPanel>

        <WrapPanel Grid.Row="4" Margin="0,0,0,12">
            <Button Content="{loc:Loc Main_ApplyNow}" Command="{Binding ApplyMappingsNowCommand}"
                    ToolTip="{loc:Loc Tip_ApplyNow}" ToolTipService.ShowOnDisabled="True"
                    Padding="10,6" Margin="0,0,10,0"/>
            <Button Content="{loc:Loc Main_CheckServiceStatus}" Command="{Binding CheckServiceStatusCommand}"
                    ToolTip="{loc:Loc Tip_CheckStatus}" ToolTipService.ShowOnDisabled="True"
                    Padding="10,6" Margin="0,0,10,0"/>
            <Button Content="{loc:Loc Main_ShowDiagnosticsLog}" Click="ShowLogWindow_OnClick"
                    ToolTip="{loc:Loc Tip_ShowLog}" Padding="10,6"/>
        </WrapPanel>

        <TextBlock Grid.Row="5" Text="{Binding InstructionMessage}" TextWrapping="Wrap" FontWeight="SemiBold"
                   Foreground="#B8860B" Margin="0,0,0,8"/>

        <Border Grid.Row="6" VerticalAlignment="Bottom" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Loc Main_StatusLabel}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

