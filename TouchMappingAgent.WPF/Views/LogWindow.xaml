<Window x:Class="TouchMappingAgent.WPF.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TouchMappingAgent.WPF.Localization"
        Title="{loc:Loc Log_WindowTitle}" Height="440" Width="700" MinHeight="240" MinWidth="400"
        Icon="pack://application:,,,/TouchMappingAgent.WPF;component/Assets/touchmappingagent.ico"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0"
                 x:Name="LogTextBox"
                 Text="{Binding LogText, Mode=OneWay}"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 TextChanged="LogTextBox_OnTextChanged"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{loc:Loc Log_Clear}" Command="{Binding ClearLogCommand}" Padding="12,5" Margin="0,0,8,0"/>
            <Button Content="{loc:Loc Log_Copy}" Command="{Binding CopyLogCommand}" Padding="12,5" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>

