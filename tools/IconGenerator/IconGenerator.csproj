<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately NOT part of TouchMappingAgent.sln: this is a one-shot asset generator, not a
    shipped component. Keeping it out of the solution means it can never break the product
    build, while still living in the repository so the assets stay reproducible.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>

</Project>
